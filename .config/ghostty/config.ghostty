# ~/.config/ghostty/config

# ------------------------------------------------------------
# Clipboard
# ------------------------------------------------------------
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# ------------------------------------------------------------
# Tabs
# ------------------------------------------------------------
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface

# Move between tabs
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab

# Optional: direct tab selection, similar to browsers
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5
keybind = cmd+6=goto_tab:6
keybind = cmd+7=goto_tab:7
keybind = cmd+8=goto_tab:8
keybind = cmd+9=last_tab

# ------------------------------------------------------------
# Panes / splits
# ------------------------------------------------------------

# New pane to the right
keybind = cmd+d=new_split:right

# New pane below
keybind = cmd+shift+d=new_split:down

# Close current pane/tab/window surface
keybind = cmd+shift+w=close_surface

# ------------------------------------------------------------
# Navigate between panes
# ------------------------------------------------------------

# Vim-style pane navigation
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:bottom
keybind = cmd+k=goto_split:top
keybind = cmd+l=goto_split:right

# Arrow-key pane navigation
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+right=goto_split:right

# ------------------------------------------------------------
# Resize active pane
# ------------------------------------------------------------

keybind = cmd+ctrl+left=resize_split:left,10
keybind = cmd+ctrl+down=resize_split:down,10
keybind = cmd+ctrl+up=resize_split:up,10
keybind = cmd+ctrl+right=resize_split:right,10

# ------------------------------------------------------------
# Reload config
# ------------------------------------------------------------
keybind = cmd+shift+r=reload_config